# ── Required secrets ──────────────────────────────────────────────────────
# Set these as GitHub Actions secrets (Settings → Secrets → Actions).
# The CI deploy script writes them to .env on the server automatically.

JWT_SECRET=change-me-use-a-long-random-string
GEMINI_API_KEY=                              # get one at aistudio.google.com/app/apikey

# ── Optional ──────────────────────────────────────────────────────────────
PORT=3000

# ELASTICSEARCH_NODE — leave unset in production.
# docker-compose.prod.yml hardcodes http://elasticsearch:9200 (Docker network)
# which takes precedence over this file. Only set this for local dev
# if your Elasticsearch runs somewhere other than localhost:9200.
# ELASTICSEARCH_NODE=http://localhost:9200
